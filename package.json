{
  "name": "vowvel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:full": "wrangler dev",
    "build": "node scripts/generate-favicons.mjs && tsc -b && tsc -p tsconfig.worker.json && vite build && node scripts/generate-sharing.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply vowvel --local",
    "db:migrate:remote": "wrangler d1 migrations apply vowvel --remote",
    "types:worker": "wrangler types --env-interface CloudflareEnv",
    "deploy": "SITE_URL=\"${SITE_URL:-https://vowvel.com}\" npm run build && wrangler deploy",
    "deploy:check": "SITE_URL=\"${SITE_URL:-https://vowvel.com}\" npm run build && wrangler deploy --dry-run",
    "predeploy": "node scripts/check-site-url.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^13.3.0",
    "razorpay": "^2.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.2"
  }
}
