{
  "issuer": "https://vowvel.com",
  "authorization_endpoint": "https://vowvel.com/oauth/authorize",
  "token_endpoint": "https://vowvel.com/api/auth/token",
  "userinfo_endpoint": "https://vowvel.com/api/auth/userinfo",
  "jwks_uri": "https://vowvel.com/.well-known/jwks.json",
  "response_types_supported": ["code", "token", "id_token"],
  "subject_types_supported": ["public"],
  "id_token_signing_alg_values_supported": ["RS256", "EdDSA"],
  "grant_types_supported": [
    "authorization_code",
    "client_credentials",
    "urn:ietf:params:oauth:grant-type:token-exchange"
  ],
  "scopes_supported": [
    "openid",
    "profile",
    "email",
    "invitations:read",
    "invitations:write",
    "orders:read",
    "orders:create",
    "rsvp:write"
  ],
  "token_endpoint_auth_methods_supported": [
    "client_secret_basic",
    "client_secret_post",
    "private_key_jwt"
  ],
  "revocation_endpoint": "https://vowvel.com/api/auth/token/revoke",
  "agent_auth": {
    "skill": "https://vowvel.com/.well-known/agent-skills/invitation-curator/SKILL.md",
    "register_uri": "https://vowvel.com/api/auth/agent/register",
    "identity_types_supported": ["anonymous", "identity_assertion"],
    "identity_assertion": {
      "assertion_types_supported": [
        "verified_email",
        "urn:ietf:params:oauth:token-type:id-jag"
      ],
      "credential_types_supported": ["bearer_token"]
    },
    "anonymous": {
      "credential_types_supported": ["bearer_token"]
    }
  }
}
